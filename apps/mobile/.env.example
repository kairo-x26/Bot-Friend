# Where the Bot-Friend API runs. Use your machine's LAN IP when testing on a phone.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Optional: Google sign-in client ids (leave empty to hide the button).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Show the email dev sign-in in non-dev builds (staging, web previews).
EXPO_PUBLIC_DEV_LOGIN=
