# Copy to .env. Everything has a sensible local default except secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated; empty allows any origin outside production.
CORS_ORIGINS=

# Postgres from docker-compose. Set DATABASE_EMBEDDED=true to run without Docker (PGlite).
DATABASE_URL=postgres://botfriend:botfriend@localhost:5432/botfriend
DATABASE_EMBEDDED=false
# DATABASE_EMBEDDED_DIR=./.pglite
RUN_MIGRATIONS=true

# Optional; enables shared rate limits across instances.
# REDIS_URL=redis://localhost:6379

# At least 32 chars in production: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
SESSION_TTL_HOURS=720
# Email-only sign-in for local dev and the admin dashboard. Never in production.
AUTH_DEV_LOGIN=true
# Dev-login emails that become admins on first sign-in (for trying the moderation dashboard).
DEV_ADMIN_EMAILS=admin@botfriend.local
# OAuth client ids allowed as id_token audience (comma-separated).
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=

# 'mock' works offline with canned replies. 'openai' needs a key.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_MODERATION_MODEL=omni-moderation-latest
AI_MAX_OUTPUT_TOKENS=400
AI_HISTORY_MESSAGES=20
AI_HISTORY_CHAR_BUDGET=12000
AI_TIMEOUT_MS=30000
AI_INPUT_COST_PER_MTOK=0.25
AI_OUTPUT_COST_PER_MTOK=2
# Pause chat for everyone once estimated spend today passes this (USD). 0 = off.
AI_DAILY_BUDGET_USD=0

QUOTA_GUEST_DAILY=20
QUOTA_FREE_DAILY=80
QUOTA_PREMIUM_DAILY=600
RATE_LIMIT_MESSAGES_PER_MINUTE=12
RATE_LIMIT_AUTH_PER_MINUTE=20

GUEST_RETENTION_DAYS=7
ANALYTICS_RETENTION_DAYS=90
RETENTION_SWEEP_MINUTES=60

FEATURE_MEMORY=true
FEATURE_VOICE=false
FEATURE_BILLING=false
